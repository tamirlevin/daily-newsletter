{
  "schemaVersion": 2,
  "timeZone": "Australia/Melbourne",
  "cadences": {
    "daily": {
      "lookbackDays": 3,
      "maxItems": 5,
      "editorialMix": {
        "executive": 0.6,
        "technical": 0.2,
        "builder": 0.2
      },
      "expectedMix": {
        "executive": 3,
        "technical": 1,
        "builder": 1
      },
      "selectionRules": {
        "maxModelLabItems": 2
      },
      "retainedRuns": 7,
      "emailEnabled": true
    },
    "weekly": {
      "lookbackDays": 7,
      "maxItems": 10,
      "editorialMix": {
        "executive": 0.7,
        "technical": 0.2,
        "builder": 0.1
      },
      "expectedMix": {
        "executive": 7,
        "technical": 2,
        "builder": 1
      },
      "selectionRules": {
        "maxModelLabItems": 3
      },
      "retainedRuns": 3,
      "emailEnabled": false
    }
  },
  "enrichmentPoolMultiplier": 3,
  "requestConcurrency": 4,
  "sourceSignals": {
    "discoveryWeight": {
      "diverse-newsletter": 1,
      "independent-publication": 1,
      "practitioner-signal": 0.92,
      "community-signal": 0.85,
      "official-ecosystem": 0.68,
      "official-builder": 0.5,
      "official-lab": 0.3
    },
    "evidenceAuthority": {
      "diverse-newsletter": 0.45,
      "independent-publication": 0.65,
      "practitioner-signal": 0.7,
      "community-signal": 0.25,
      "official-ecosystem": 1,
      "official-builder": 1,
      "official-lab": 1
    }
  },
  "selectionRules": {
    "maxUncorroboratedOfficialItemsPerVendor": 1,
    "modelLabVendors": [
      "openai",
      "anthropic",
      "google",
      "meta",
      "mistral",
      "xai",
      "deepseek",
      "alibaba",
      "cohere"
    ],
    "maxModelLabItemsPerVendor": 1,
    "maxSoleDiscoveryItemsBySource": {
      "hacker-news": 3,
      "infoq-ai-ml-news": 2,
      "simon-coding-agents": 1
    },
    "maxSoleDiscoveryItemsBySourcePerLane": {
      "hacker-news": 1,
      "infoq-ai-ml-news": 1,
      "simon-coding-agents": 1
    }
  },
  "sources": [
    {
      "id": "tldr-ai",
      "name": "TLDR AI",
      "type": "tldr",
      "role": "diverse-newsletter",
      "kind": "discovery",
      "enabled": true,
      "feedUrl": "https://tldr.tech/api/rss/ai",
      "maxIssues": 5
    },
    {
      "id": "alphasignal",
      "name": "AlphaSignal",
      "type": "alphasignal",
      "role": "diverse-newsletter",
      "kind": "discovery",
      "enabled": true,
      "sitemapUrl": "https://alphasignal.ai/sitemaps/news.xml",
      "maxEntries": 120
    },
    {
      "id": "infoq-ai-ml-news",
      "name": "InfoQ AI/ML News",
      "type": "official-rss",
      "role": "independent-publication",
      "kind": "discovery",
      "enabled": true,
      "feedUrl": "https://feed.infoq.com/ai-ml-data-eng/news/",
      "defaultSection": "AI, ML & Data Engineering",
      "requireContentPatterns": [
        "\\bAI\\b",
        "artificial intelligence",
        "machine learning",
        "large language model",
        "\\bLLMs?\\b",
        "generative AI",
        "\\bagents?\\b",
        "agentic",
        "\\bMCP\\b",
        "model context protocol",
        "tool calling",
        "computer use"
      ],
      "maxItems": 100
    },
    {
      "id": "hacker-news",
      "name": "Hacker News",
      "type": "hackernews",
      "role": "community-signal",
      "kind": "discovery",
      "enabled": true,
      "apiUrl": "https://hn.algolia.com/api/v1/search_by_date",
      "minPoints": 20,
      "hitsPerPage": 500,
      "maxPages": 2
    },
    {
      "id": "simon-coding-agents",
      "name": "Simon Willison — Coding Agents",
      "type": "official-rss",
      "role": "practitioner-signal",
      "kind": "discovery",
      "enabled": true,
      "feedUrl": "https://simonwillison.net/tags/coding-agents.atom",
      "defaultSection": "Coding Agents",
      "maxItems": 100
    },
    {
      "id": "cloudflare-agents",
      "name": "Cloudflare Agents",
      "type": "official-rss",
      "role": "official-builder",
      "kind": "primary",
      "vendor": "cloudflare",
      "enabled": true,
      "feedUrl": "https://blog.cloudflare.com/tag/agents/rss",
      "defaultSection": "Agents",
      "maxItems": 100
    },
    {
      "id": "mcp-blog",
      "name": "Model Context Protocol Blog",
      "type": "official-rss",
      "role": "official-ecosystem",
      "kind": "primary",
      "vendor": "model-context-protocol",
      "enabled": true,
      "feedUrl": "https://blog.modelcontextprotocol.io/index.xml",
      "defaultSection": "Model Context Protocol",
      "maxItems": 100
    },
    {
      "id": "openai-news",
      "name": "OpenAI News",
      "type": "official-rss",
      "role": "official-lab",
      "kind": "primary",
      "vendor": "openai",
      "enabled": true,
      "feedUrl": "https://openai.com/news/rss.xml",
      "defaultSection": "OpenAI News",
      "maxItems": 100
    },
    {
      "id": "anthropic-news",
      "name": "Anthropic News",
      "type": "anthropic",
      "role": "official-lab",
      "kind": "primary",
      "vendor": "anthropic",
      "enabled": true,
      "url": "https://www.anthropic.com/news",
      "maxItems": 50
    },
    {
      "id": "google-ai-news",
      "name": "Google AI / DeepMind",
      "type": "official-rss",
      "role": "official-lab",
      "kind": "primary",
      "vendor": "google",
      "enabled": true,
      "feedUrl": "https://blog.google/rss/",
      "defaultSection": "Google AI",
      "includeCategoryPatterns": [
        "^AI$",
        "^Gemini$",
        "^Gemini App$",
        "^Gemini models$",
        "^Google DeepMind$"
      ],
      "includeUrlPatterns": [
        "/innovation-and-ai/models-and-research/",
        "/products-and-platforms/products/gemini/"
      ],
      "excludeTitlePatterns": [
        "\\b(?:tips?|ways) (?:for|to)\\b",
        "\\bPixel Drop\\b",
        "\\bGalaxy Unpacked\\b"
      ],
      "maxItems": 100
    }
  ]
}
